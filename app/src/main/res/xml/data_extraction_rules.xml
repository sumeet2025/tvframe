<?xml version="1.0" encoding="utf-8"?>
<!-- TVFrame keeps everything on the TV: no cloud backup and no device-to-device transfer.
     This keeps the saved SMB login and the photo database off backups. (Android 12+) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
